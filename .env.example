# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URI=postgresql://postgres.<project>:<password>@aws-1-eu-north-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-1-eu-north-1.pooler.supabase.com:5432/postgres

# ── Payload ──────────────────────────────────────────────────────────────────
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=https://content.ourmoon.org.uk

# ── Azure Blob Storage ───────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=ourmoonwebassets;AccountKey=...;EndpointSuffix=core.windows.net

# ── Email (Mailgun SMTP) ─────────────────────────────────────────────────────
SMTP_PASS=YOUR_MAILGUN_SMTP_PASSWORD

# ── Preview / Live Preview ───────────────────────────────────────────────────
PREVIEW_SECRET=generate-a-random-32-char-string-here
NEXT_PUBLIC_FRONTEND_URL=https://devnext.ourmoon.org.uk

# ── Webhooks (frontend ISR revalidation) ────────────────────────────────────
FRONTEND_REVALIDATE_URL=https://devnext.ourmoon.org.uk/api/revalidate
FRONTEND_REVALIDATE_SECRET=generate-a-random-32-char-string-here

# ── Google SSO ──────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client (Web application) — add this authorised redirect URI:
#   https://content.ourmoon.org.uk/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── MCP / Claude Code ────────────────────────────────────────────────────────
PAYLOAD_API_KEY=generate-in-admin-panel-users-your-account-enable-api-key

# ── Seed Script ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@ourmoon.org.uk
SEED_ADMIN_PASSWORD=STRONG_PASSWORD_HERE
